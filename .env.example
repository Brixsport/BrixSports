# Turso Database Configuration
# Get your credentials from: https://turso.tech/app
# Or use Turso CLI: turso db tokens create <database-name>

TURSO_CONNECTION_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here

# Example:
# TURSO_CONNECTION_URL=libsql://brixsportv2-brixsports.aws-eu-west-1.turso.io
# TURSO_AUTH_TOKEN=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9...

# JWT Authentication Secret
# MUST be different per environment (staging vs prod) — shared JWT_SECRET means
# staging-issued tokens are valid on prod API routes.
# Generate a unique value per environment:
#   openssl rand -hex 32
# Set independently in each Vercel project's env vars. Never reuse across envs.
JWT_SECRET=your-jwt-secret-here

# NextAuth (src/app/api/auth/[...nextauth]/route.ts) — REQUIRED in production if the
# NextAuth route is used. Unique per environment, same rule as JWT_SECRET.
NEXTAUTH_SECRET=your-nextauth-secret-here

# Session cookie domain — OPTIONAL. Only applied when NODE_ENV=production
# (login/register/Google callback routes), e.g. the apex domain of the prod site.
# Leave empty to scope the cookie to the current host.
COOKIE_DOMAIN=

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# WebSocket Configuration
# NEXT_PUBLIC_WS_URL — the standalone ws-server's public URL (client Socket.IO connection).
# In production this points at the Railway-deployed ws-server/ (see ws-server/README.md),
# not this repo's root server.js (that one is local-dev only, never actually deployed).
NEXT_PUBLIC_WS_URL=http://localhost:3000
# WS_SERVER_URL — same ws-server URL, read server-side for the /broadcast HTTP fallback
# (src/lib/socket.ts). Usually identical to NEXT_PUBLIC_WS_URL; kept separate in case the
# server-to-server URL ever needs to differ (private networking, etc).
WS_SERVER_URL=http://localhost:3000
# WS_API_KEY — shared secret for ws-server/index.js's POST /broadcast endpoint (x-api-key
# header). MUST be set to the exact same value in both this app's deployment (Vercel) and
# the ws-server Railway service's own environment variables — if they don't match, every
# broadcast call silently 401s and no error surfaces anywhere in this app's own logs.
WS_API_KEY=your-ws-api-key-here

# Push Notifications (VAPID Keys)
# MUST be different per environment (staging vs prod) — shared VAPID keys mean
# staging test matches fire real push notifications to prod subscribers.
# The keys that were previously in this file have been rotated and are no longer valid.
# Generate a fresh keypair per environment:
#   npx web-push generate-vapid-keys
# Set independently in each Vercel project's env vars. Never reuse across envs.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=mailto:admin@brixsport.com

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary (for image uploads)
# The two NEXT_PUBLIC_ vars are read by the browser upload widgets.
# CLOUDINARY_CLOUD_NAME / CLOUDINARY_API_KEY / CLOUDINARY_API_SECRET are server-only and
# used by /api/cloudinary/sign (signed uploads, incl. team logos) — REQUIRED in production
# for those uploads. Never expose the API secret to the client.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=brix_uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (src/lib/email.ts) — used for password reset etc.; at least one provider is
# REQUIRED in production for emails to send. AWS SES is preferred when both
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are set, otherwise Gmail via EMAIL_PASS.
# Gmail (use a 16-character App Password, not the account password):
EMAIL_USER=
EMAIL_PASS=
# AWS SES — OPTIONAL. AWS_REGION defaults to us-east-1.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_FROM_EMAIL=
AWS_SES_FROM_NAME=Brixsports
# UNUSED: EMAIL_SERVICE_API_KEY and EMAIL_FROM below are not read by any code under
# src/ (verified by search 2026-10-04); setting them has no effect. Kept only so
# existing environments do not look like drift — remove once confirmed unused elsewhere.
EMAIL_SERVICE_API_KEY=
EMAIL_FROM=noreply@brixsport.com

# Feature Flags (Optional)
ENABLE_LIVESTREAM=true
ENABLE_PREDICTIONS=true
ENABLE_PUSH_NOTIFICATIONS=true

# Cron Job Secret (for the reminder checker, /api/reminders/check) — REQUIRED in
# production. The route fails closed (401) when this is unset. Must match the
# CRON_SECRET GitHub Actions secret used by reminder-checker.yml.
CRON_SECRET=your-cron-secret-here

# Sentry Error Monitoring
# Get DSN from: https://sentry.io → Project Settings → Client Keys
# SENTRY_DSN is server-side only. NEXT_PUBLIC_SENTRY_DSN is exposed to the browser.
SENTRY_DSN=https://your-key@o0.ingest.sentry.io/your-project-id
NEXT_PUBLIC_SENTRY_DSN=https://your-key@o0.ingest.sentry.io/your-project-id
# Auth token for source map upload — generate at: https://sentry.io/settings/auth-tokens/
SENTRY_AUTH_TOKEN=your-sentry-auth-token
# Sentry org slug and project slug (from your Sentry project URL)
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
# Environment tag — controls which Sentry environment issues are filed under.
# Set to "staging" in the staging Vercel project, "production" in prod.
# Defaults to "production" if not set.
SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# Google Analytics 4 — get the Measurement ID from GA4 → Admin → Data Streams.
# Gated: unset locally/staging so dev traffic never pollutes production analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Vercel Analytics + Speed Insights need no env vars — auto-detected on Vercel,
# inert no-ops anywhere else.

# Environment identifier
# Controls staging-wide auth gate in middleware and client-side env detection.
# Values: 'development' | 'staging' | 'production'
# Set to 'staging' in Vercel staging project env vars.
# Set to 'production' in Vercel prod project env vars.
# Leave as 'development' for local dev.
NEXT_PUBLIC_ENV=development

# Production Settings
NODE_ENV=development

# Upstash Redis (BACKLOG-080) — optional. Backs rate limiting on the auth
# endpoints (login/register/forgot-password) and other write endpoints.
# Absent locally is fine: falls back to an in-memory per-instance limiter.
# Get credentials from: https://console.upstash.com/ → your Redis DB → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
