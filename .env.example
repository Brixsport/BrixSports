# Turso Database Configuration
# Get your credentials from: https://turso.tech/app
# Or use Turso CLI: turso db tokens create <database-name>

TURSO_CONNECTION_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here

# Example:
# TURSO_CONNECTION_URL=libsql://brixsportv2-brixsports.aws-eu-west-1.turso.io
# TURSO_AUTH_TOKEN=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9...

# JWT Authentication Secret
# Generate a secure random string for production
# You can use: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Example:
# JWT_SECRET=8f3a9b2c1d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# WebSocket Configuration
NEXT_PUBLIC_WS_URL=http://localhost:3000

# Push Notifications (VAPID Keys)
# Generate VAPID keys using: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BDYyajLbF8Op4vstjSIzBPKRd_qLxvQpYRJBj9VLBoe6TZF-dJVQOWtwxCGvMyas1qp7NImmBUgenK4Eu7krPcA
VAPID_PRIVATE_KEY=tNgRs7W4-tDhaqLot8FTt2GUkV50jSBI0ltcqkEW_Jw
VAPID_SUBJECT=mailto:admin@brixsport.com

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary (for image uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=brix_uploads

# Email Service (for password reset)
# Use Resend, SendGrid, or AWS SES
EMAIL_SERVICE_API_KEY=
EMAIL_FROM=noreply@brixsport.com

# Feature Flags (Optional)
ENABLE_LIVESTREAM=true
ENABLE_PREDICTIONS=true
ENABLE_PUSH_NOTIFICATIONS=true

# Cron Job Secret (for reminder checker)
CRON_SECRET=dev-cron-secret-change-in-production

# Sentry Error Monitoring
# Get DSN from: https://sentry.io → Project Settings → Client Keys
# SENTRY_DSN is server-side only. NEXT_PUBLIC_SENTRY_DSN is exposed to the browser.
SENTRY_DSN=https://your-key@o0.ingest.sentry.io/your-project-id
NEXT_PUBLIC_SENTRY_DSN=https://your-key@o0.ingest.sentry.io/your-project-id
# Auth token for source map upload — generate at: https://sentry.io/settings/auth-tokens/
SENTRY_AUTH_TOKEN=your-sentry-auth-token
# Sentry org slug and project slug (from your Sentry project URL)
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project

# Production Settings
NODE_ENV=development
