{
    "headers": [
        {
            "source": "/api/(.*)",
            "headers": [
                {
                    "key": "Access-Control-Allow-Origin",
                    "value": "*"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/admin/:path*",
            "destination": "/admin/:path*"
        }
    ],
    "crons": [
        {
            "path": "/api/reminders/check",
            "schedule": "*/5 * * * *"
        }
    ]
}