{
    "crons": [
        {
            "path": "/api/reminders/check",
            "schedule": "0 10 * * *"
        },
        {
            "path": "/api/notifications/match-reminders",
            "schedule": "*/5 * * * *"
        }
    ],
    "headers": [
        {
            "source": "/api/(.*)",
            "headers": [
                {
                    "key": "Access-Control-Allow-Origin",
                    "value": "*"
                }
            ]
        }
    ]
}