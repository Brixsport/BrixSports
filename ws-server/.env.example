# Port the server listens on. Railway sets this automatically in production.
PORT=3001

# Shared secret checked against the x-api-key header on POST /broadcast and
# POST /infrastructure/endpoint. Vercel's src/lib/socket.ts sends this same
# value when triggering a broadcast after a confirmed DB write.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WS_API_KEY=

# Used to build the Socket.IO CORS allowlist alongside the hardcoded
# brixsports.com/www.brixsports.com/*.vercel.app entries in index.js.
NEXT_PUBLIC_APP_URL=https://brixsports.com

# This single Railway instance serves BOTH staging and prod but staging and prod sign logger JWTs with DIFFERENT secrets. 
# Both must be set here, copied exactly from each
# environment's own Vercel project (Settings -> Environment Variables ->
# JWT_SECRET), or logger-only WebSocket actions (event:log,
# match:time:update, etc.) will be silently rejected for real loggers on
# whichever environment's secret is missing/wrong. See the io.use()
# middleware in index.js for how the right one is selected per connection.
JWT_SECRET_STAGING=
JWT_SECRET_PROD=
