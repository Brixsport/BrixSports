# Environment files
.env.local
.env

# Database
local.db
*.db
*.db-shm
*.db-wal

# Build artifacts
node_modules
.next

# TypeScript build info (regenerated on each build)
*.tsbuildinfo

# Documentation and guides (not needed for deployment)
*.md
!README.md

# Internal session docs/tooling -- BACKLOG, RUNLOG, audits, etc. *.md already
# catches most of it, but this covers the whole directory (any non-.md content
# too) explicitly rather than relying on that alone.
.agents/*

# Scripts (not needed for production)
scripts/

# Test files
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
