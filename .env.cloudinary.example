# Cloudinary Configuration
# Sign up at https://cloudinary.com to get your credentials

# Cloudinary Cloud Name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name_here

# Cloudinary Upload Preset (create an unsigned preset in your Cloudinary dashboard)
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=brix_uploads

# Cloudinary API Key (optional, for server-side operations)
CLOUDINARY_API_KEY=your_api_key_here

# Cloudinary API Secret (optional, for server-side operations)
CLOUDINARY_API_SECRET=your_api_secret_here
